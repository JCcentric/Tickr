{
  "expo": {
    "name": "TICKR",
    "slug": "TickrApp",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/TICKR_Icon.png",
    "scheme": "tickrapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1.2.0",
      "bundleIdentifier": "com.jccentric.TickrApp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to set profile pictures and event images.",
        "NSCameraUsageDescription": "This app needs camera access to take photos for events.",
        "NSUserNotificationUsageDescription": "This app uses notifications to remind you about your scheduled events.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 3,
      "package": "com.jccentric.TickrApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "newArchEnabled": false,
            "podfileProperties": {
              "use_modular_headers": "true"
            }
          }
        }
      ],
      
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/notification-bell-sound-376888.wav"]
        }
      ],
      
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/TICKR_Icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-5948289925255821~5581271378"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eaaf8cc9-13a8-499b-afe8-e026a1cd62f0"
      }
    },
    "owner": "jccentric",
    "runtimeVersion": "1.2.0",
    "updates": {
      "url": "https://u.expo.dev/eaaf8cc9-13a8-499b-afe8-e026a1cd62f0"
    }
  }
}
