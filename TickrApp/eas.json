{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true,
        "env": {
          "GOOGLE_SERVICES_PLIST": "@GOOGLE_SERVICE_PLIST",
          "API_KEY": "@API_KEY",
          "AUTH_DOMAIN": "@AUTH_DOMAIN",
          "PROJECT_ID": "@PROJECT_ID",
          "STORAGE_BUCKET": "@STORAGE_BUCKET",
          "MESSAGE_SENDER_ID": "@MESSAGE_SENDER_ID",
          "APP_ID": "@APP_ID"
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true,
        "autoIncrement": true,
        "credentialsSource": "remote",
        "env": {
          "GOOGLE_SERVICES_PLIST": "@GOOGLE_SERVICE_PLIST",
          "API_KEY": "@API_KEY",
          "AUTH_DOMAIN": "@AUTH_DOMAIN",
          "PROJECT_ID": "@PROJECT_ID",
          "STORAGE_BUCKET": "@STORAGE_BUCKET",
          "MESSAGE_SENDER_ID": "@MESSAGE_SENDER_ID",
          "APP_ID": "@APP_ID"
        }
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false,
        "autoIncrement": true,
        "credentialsSource": "remote",
        "env": {
          "GOOGLE_SERVICES_PLIST": "@GOOGLE_SERVICE_PLIST",
          "API_KEY": "@API_KEY",
          "AUTH_DOMAIN": "@AUTH_DOMAIN",
          "PROJECT_ID": "@PROJECT_ID",
          "STORAGE_BUCKET": "@STORAGE_BUCKET",
          "MESSAGE_SENDER_ID": "@MESSAGE_SENDER_ID",
          "APP_ID": "@APP_ID"
        }
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {}
    }
  }
}
